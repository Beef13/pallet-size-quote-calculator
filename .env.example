# Accounts and online storage are optional. Leave these unset and the app keeps everything
# on the device, exactly as before.
#
# To switch them on, copy this file to .env.local and fill in the two values from your
# Supabase project (Project settings > API). The publishable key is safe to ship to browsers:
# the database's own rules decide what each signed-in person can see.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to 1 once Google sign-in has been set up in Supabase (Authentication > Providers)
VITE_AUTH_GOOGLE=

# Paid subscriptions. Set this to the Stripe payment link (https://buy.stripe.com/...) once
# the Stripe account is live. While it is unset, the Terms and Privacy pages say Pallet Quoter
# is free and make no mention of payment.
VITE_STRIPE_PAYMENT_LINK=

# Optional: the payment link for the yearly price. While it is unset, the pricing section
# only offers and mentions the monthly price.
VITE_STRIPE_PAYMENT_LINK_YEARLY=
